{
  "name": "@corner-store/rfq-postgres",
  "version": "0.1.0",
  "description": "Optional PostgreSQL HA coordinator store and reconciliation worker for Corner Store RFQ hosts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "GPL-3.0-or-later",
  "files": [
    "dist/src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/decipherhub/corner-store.git",
    "directory": "services/rfq-postgres"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.js",
    "test:postgres": "CORNER_STORE_REQUIRE_POSTGRES=1 npm test"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "peerDependencies": {
    "@corner-store/rfq-service": "^0.1.0"
  },
  "devDependencies": {
    "@corner-store/rfq-service": "file:../rfq",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "typescript": "^5.7.3"
  }
}
