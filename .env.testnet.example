# Public testnet connection. Do not commit credential-bearing RPC URLs.
RPC_URL=
CHAIN_ID=

# Foundry sender address. Import its key with:
# cast wallet import corner-store-testnet --interactive
CORNER_STORE_TESTNET_DEPLOYER=

# For a hackathon fixture these may equal the deployer. For a production
# deployment use the separate production workflow and an existing Safe.
CORNER_STORE_GOVERNANCE=
CORNER_STORE_OPERATOR=

# Externally controlled demo wallets. The maker and investors approve the RFQ
# adapter in separate transactions after deployment.
CORNER_STORE_TESTNET_MAKER=
CORNER_STORE_TESTNET_INVESTOR=
CORNER_STORE_TESTNET_INVESTOR_B=
CORNER_STORE_TESTNET_INELIGIBLE_INVESTOR=

# Ephemeral mock Trusted Issuer signing key used only to construct test
# ONCHAINID claims. Generate it securely and never commit the value.
CORNER_STORE_TESTNET_ISSUER_KEY=

# Optional deployment metadata.
CORNER_STORE_DEPLOYMENT_ID=hackathon-testnet-rfq
# Defaults to deployments/public/<deployment-id>-<chain-id>.json on broadcast.
# CORNER_STORE_ARTIFACT=

# Optional initial inventory in 18-decimal base units.
# CORNER_STORE_TESTNET_INVESTOR_QUOTE=
# CORNER_STORE_TESTNET_INVESTOR_RWA=
# CORNER_STORE_TESTNET_MAKER_QUOTE=
# CORNER_STORE_TESTNET_MAKER_RWA=
